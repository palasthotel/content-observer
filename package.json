{
  "name": "@palasthotel/content-observer",
  "version": "1.2.4",
  "private": true,
  "description": "Efficiently observe content changes between WordPress instances.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Palasthotel",
    "email": "webmaster@palasthotel.de",
    "url": "https://palasthotel.de"
  },
  "repository": "git+https://github.com/palasthotel/wp-content-observer.git",
  "bugs": {
    "url": "https://github.com/palasthotel/wp-content-observer/issues"
  },
  "scripts": {
    "watch": "wp-scripts start --config webpack.config.js",
    "build": "wp-scripts build --config webpack.config.js",
    "pack": "SLUG=content-observer bash ../github-workflows/wp-plugin/bin/pack.sh",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cyclonedx/webpack-plugin": "5.3.3",
    "@types/react": "^19.3.0",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/element": "^10.0.0",
    "@wordpress/scripts": "^37.0.0",
    "date-fns": "^4.4.0",
    "react-jss": "^10.10.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
